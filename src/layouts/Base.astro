---
import '../styles/global.css';
import { site } from '../data/site';
import { photoSrc } from '../data/photos';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
const banner = photoSrc('norway-island-dusk', 2400);
interface Props { title?: string; description?: string; image?: string; imageAlt?: string }
const {
  title,
  description = site.tagline,
  image = '/og.jpg',
  imageAlt = 'Zak Stoiber: marketing analytics, data projects and photographs',
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/resume/', label: 'Resume' },
  { href: '/photographs/', label: 'Photographs' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121413" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      url: Astro.site?.href,
      jobTitle: 'Marketing Analytics Leader',
      address: { '@type': 'PostalAddress', addressLocality: 'Milwaukee', addressRegion: 'WI', addressCountry: 'US' },
      sameAs: [site.links.linkedin, site.links.tableau, site.links.photography],
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="banner">
      <picture>
        <source type="image/webp" srcset={banner.webpSrcset} sizes="100vw" />
        <img src={banner.src} srcset={banner.srcset} sizes="100vw" alt="" fetchpriority="high" />
      </picture>
      <div class="wrap masthead">
        <a href="/" class="name">Zak Stoiber</a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="kicker">Get in touch</p>
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="cols">
          <div>
            <p class="mono">Elsewhere</p>
            <ul>
              <li><a href={site.links.linkedin}>LinkedIn</a></li>
              <li><a href={site.links.tableau}>Tableau Public</a></li>
              <li><a href={site.links.photography}>slicksnaps.com</a></li>
            </ul>
          </div>
          <div>
            <p class="mono">Based in</p>
            <p>Milwaukee, Wisconsin</p>
          </div>
          <div class="colophon">
            <p class="mono">Colophon</p>
            <p>Set in Newsreader and IBM Plex Mono. Built with Astro. Every photograph on this site is my own.</p>
          </div>
        </div>
        <p class="mono copyright">© {new Date().getFullYear()} Zak Stoiber</p>
      </div>
    </footer>
  </body>
</html>
<style>
  /* Header photo: the rocky island at dusk, Norway 2025 */
  .banner { position: relative; height: clamp(150px, 19vw, 290px); overflow: hidden; background: #2d4f73; }
  .banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }
  .banner::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 70%;
    background: linear-gradient(to top, rgba(8, 22, 38, 0.55), rgba(8, 22, 38, 0));
  }
  .masthead {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
    display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 2rem;
    padding-top: 1rem; padding-bottom: 1.1rem; color: #fff;
  }
  .name { font-size: clamp(1.35rem, 2.4vw, 1.75rem); color: #fff; text-decoration: none; letter-spacing: -0.01em; }
  .name:hover { color: #fff; text-decoration: underline; text-decoration-thickness: 1px; }
  nav { display: flex; gap: clamp(1rem, 3vw, 2rem); }
  nav a {
    font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85); text-decoration: none; padding-bottom: 3px; border-bottom: 1px solid transparent;
  }
  nav a:hover, nav a[aria-current='page'] { color: #fff; border-bottom-color: #fff; }
  .site-footer { background: var(--paper-2); margin-top: clamp(3rem, 8vw, 6rem); padding: clamp(3rem, 7vw, 5rem) 0 2rem; }
  .email {
    display: inline-block; font-size: clamp(1.8rem, 5vw, 3.5rem); letter-spacing: -0.02em; color: var(--ink);
    text-decoration: none; border-bottom: 1px solid var(--rule); margin: 0.4rem 0 3rem; overflow-wrap: anywhere;
  }
  .email:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2rem; font-size: 1rem; }
  .cols p { margin: 0 0 0.5rem; }
  .cols ul { list-style: none; padding: 0; margin: 0; }
  .cols li { margin-bottom: 0.3rem; }
  .cols a { color: var(--ink); }
  .cols a:hover { color: var(--accent); }
  .colophon p:last-child { color: var(--ink-2); max-width: 22rem; }
  .copyright { margin-top: 3rem; }
</style>
