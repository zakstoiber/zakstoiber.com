---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { photos, photoSrc } from '../data/photos';
import { site } from '../data/site';
const sets = [
  { name: 'Norway', note: 'May and June 2025' },
  { name: 'Artemis & Cosmo', note: 'At home' },
  { name: 'Portraits', note: 'Studio' },
] as const;
---
<Base title="Photographs" description="Landscapes from Norway, two cats, and the occasional portrait. The full portfolio is at slicksnaps.com." image="/photos/norway-fjord-dusk-1600.jpg">
  <section class="wrap intro">
    <div>
      <p class="kicker">Photographs</p>
      <h1>Mostly Norway, and two cats</h1>
    </div>
    <div class="intro-text">
      <p>Landscapes from a trip through Norway in 2025, Artemis and Cosmo at home, and the occasional portrait.
      The full portfolio lives on Slick Snaps.</p>
      <a class="go" href={site.links.photography}>Visit slicksnaps.com ↗</a>
    </div>
  </section>

  <section class="wrap">
    <Photo slug="norway-fjord-dusk" sizes="100vw" preferred={2400} eager class="lead" />
  </section>

  {sets.map((set) => (
    <section class="wrap set">
      <div class="section-head"><h2>{set.name}</h2><span class="mono">{set.note}</span></div>
      <div class="grid">
        {photos.filter((p) => p.set === set.name && p.slug !== 'norway-fjord-dusk').map((p) => (
          <a href={photoSrc(p.slug, 2400).src} class="tile">
            <Photo slug={p.slug} caption={p.set !== 'Norway'} sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw" />
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap outro">
    <p>The full portfolio is at <a href={site.links.photography}>slicksnaps.com</a>.</p>
  </section>
</Base>
<style>
  .intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2rem 4rem; align-items: end; padding-top: clamp(2rem, 6vw, 4.5rem); padding-bottom: clamp(2rem, 5vw, 3rem); }
  .intro h1 { margin-top: 1rem; }
  .intro-text p { font-size: 1.2rem; color: var(--ink-2); margin: 0 0 1.25rem; }
  @media (max-width: 52rem) { .intro { grid-template-columns: 1fr; } }
  .set { margin-top: clamp(3rem, 7vw, 5rem); }
  .grid { columns: 3 18rem; column-gap: 1.25rem; }
  .tile { display: block; break-inside: avoid; margin-bottom: 1.5rem; color: inherit; text-decoration: none; }
  .tile:hover :global(img) { opacity: 0.88; }
  .outro { margin-top: 3rem; font-size: 1.2rem; }
</style>
