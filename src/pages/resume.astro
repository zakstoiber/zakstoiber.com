---
import Base from '../layouts/Base.astro';
import { resume } from '../data/resume';
import { site } from '../data/site';
---
<Base title="Resume" description={`${resume.headline}: ${resume.focus.join(', ')}.`}>
  <section class="wrap intro">
    <p class="kicker">Resume</p>
    <h1>{resume.headline}</h1>
    <p class="focus">{resume.focus.join(' · ')}</p>
    <p class="contact mono">
      <span>{site.location}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.links.linkedin}>LinkedIn</a>
      <a class="pdf" href="/resume.pdf">Download PDF ↓</a>
    </p>
  </section>

  <div class="wrap cv">
    <section class="row">
      <h2 class="label mono">Summary</h2>
      <div class="content"><p class="summary">{resume.summary}</p></div>
    </section>

    <section class="row">
      <h2 class="label mono">Selected achievements</h2>
      <div class="content">
        <ul class="points">{resume.achievements.map(([head, body]) => <li><strong>{head}</strong> {body}</li>)}</ul>
      </div>
    </section>

    <section class="row">
      <h2 class="label mono">Experience</h2>
      <div class="content">
        <p class="employer"><strong>{resume.employer.name}</strong>, {resume.employer.place} <span class="muted">· {resume.employer.dates}, {resume.employer.note}</span></p>
        {resume.roles.map((r) => (
          <div class="role">
            <div class="role-head"><h3>{r.title}</h3><span class="mono">{r.dates}</span></div>
            <ul class="points">{r.points.map(([head, body]) => <li><strong>{head}</strong> {body}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="row">
      <h2 class="label mono">Independent projects</h2>
      <div class="content">
        <ul class="points">
          <li>
            <strong><a href="/work/board-game-trends/">Board game design trends and rating bias</a> (2026).</strong>{" "}
            31K-game BoardGameGeek catalog via API in R, modeled in DuckDB with SQL, visualized in Tableau and D3: solo-capable releases rose from 8% to 46% since the 2000s, and complexity and recency predict ratings about equally (R² 0.46, n = 16.8K).
          </li>
        </ul>
      </div>
    </section>

    <section class="row">
      <h2 class="label mono">Skills</h2>
      <div class="content">
        <dl class="skills">{resume.skills.map(([head, body]) => <div><dt>{head}</dt><dd>{body}</dd></div>)}</dl>
      </div>
    </section>

    <section class="row">
      <h2 class="label mono">Education</h2>
      <div class="content"><ul class="plain">{resume.education.map((e) => <li>{e}</li>)}</ul></div>
    </section>
  </div>
</Base>
<style>
  .intro { padding-top: clamp(2rem, 6vw, 4.5rem); padding-bottom: 2rem; }
  .intro h1 { margin: 1rem 0 0.75rem; font-size: clamp(2.4rem, 6vw, 4.75rem); }
  .focus { font-size: 1.3rem; font-style: italic; color: var(--ink-2); margin: 0 0 1.75rem; }
  .contact { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin: 0; }
  .contact a { color: var(--ink); }
  .contact .pdf { color: var(--accent); }
  .row { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: 2rem; border-top: 1px solid var(--rule); padding: 2rem 0; }
  .row:first-child { border-top-color: var(--ink); }
  .label { margin: 0.35rem 0 0; font-size: 0.75rem; font-weight: 500; position: sticky; top: 1.5rem; align-self: start; color: var(--ink); }
  .content { max-width: 46rem; }
  .summary { font-size: 1.3rem; line-height: 1.55; margin: 0; }
  .points { padding-left: 1.1rem; margin: 0; }
  .points li { margin-bottom: 0.8rem; }
  .points li::marker { color: var(--accent); }
  .points strong { font-weight: 600; }
  .employer { margin: 0 0 1.5rem; font-size: 1.15rem; }
  .role { margin-bottom: 2rem; }
  .role-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .role-head h3 { font-size: 1.45rem; }
  .skills { margin: 0; }
  .skills div { margin-bottom: 1.1rem; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0.2rem 0 0; color: var(--ink-2); }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li { margin-bottom: 0.4rem; }
  @media (max-width: 52rem) { .row { grid-template-columns: 1fr; gap: 0.75rem; } .label { position: static; } }
</style>
